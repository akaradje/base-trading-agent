# คัดลอกเป็น .env แล้วใส่คีย์จริง (อย่า commit .env)
# สมัครคีย์ที่ https://openrouter.ai/keys
OPENROUTER_API_KEY=
# ไม่ใส่คีย์ก็รันได้ — บอทจะ fallback เป็นกลยุทธ์ deterministic (EMA cross + RSI) อัตโนมัติ

# ที่อยู่ wallet สำหรับ live trading บน Base (ตั้งค่าเมื่อ mode: live)
# Wallet address for live trading on Base (set when mode: live)
# BASE_WALLET_ADDRESS=0xYourWalletAddressHere

# ===== On-Chain Signals (Phase 4) =====
# CryptoQuant — exchange flow data (สมัครฟรีที่ https://cryptoquant.com)
# Free tier: 100 req/day
# CRYPTOQUANT_API_KEY=

# Basescan — whale tracking on Base (สมัครที่ https://basescan.org/apis)
# BASESCAN_API_KEY=

# ===== Alerting (Phase 4) =====
# Telegram Bot — สร้าง bot ผ่าน @BotFather ใน Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ===== Dashboard (Phase 8) =====
# Supabase — Real-time AI Agent Dashboard (สมัครที่ https://supabase.com)
# 1. สร้าง project ใหม่
# 2. ไป Settings → API → copy URL และ anon public key
# 3. ไป SQL Editor → รัน dashboard/supabase-schema.sql
SUPABASE_URL=
SUPABASE_ANON_KEY=
